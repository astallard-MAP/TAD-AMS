rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Checks if the user is the Global Admin (Andrew Stallard)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'Djh7uHK2yZYHC4Ta4xhbguaCJVl1';
    }

    // Helper: Checks if the authenticated user owns the data via Email mapping
    function isEmailOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    // LEADS: Public can only create if valid payload. Admin can do all. Users can read/update their own by email.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAny(['email', 'phone']) 
                    && request.resource.data.keys().hasAll(['name'])
                    && (request.resource.data.name is string && request.resource.data.name.size() > 1);
      allow read, update: if isAdmin() || isEmailOwner(resource.data.email);
      allow delete: if isAdmin();
    }
    
    // PROPERTIES: Forensic data access.
    match /properties/{propId} {
      allow read: if isAdmin() || isEmailOwner(resource.data.ownerEmail);
      allow write: if isAdmin();
    }

    // MESSAGING: Strict per-user isolation.
    match /userMessages/{userId}/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /conversations/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // USER PROFILES
    match /users/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // PUBLIC DATA (News, etc.)
    match /marketUpdates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // HIVE MIND (SLIM-2.4): Strictly backend Cloud Functions only. Zero client access.
    match /knowledge/{docId} { allow read, write: if false; }
    match /experiments/{docId} { allow read, write: if false; }
    match /marketSnapshot/{docId} { allow read, write: if false; }
    match /sellerInsights/{docId} { allow read, write: if false; }
    match /playbook/{docId} { allow read, write: if false; }
    match /hashtags/{docId} { allow read, write: if false; }
    match /compliance/{docId} { allow read, write: if false; }
    match /moduleRegistry/{docId} { allow read, write: if false; }
    match /auditLog/{docId} { allow read, write: if false; }

    // GLOBAL CATCH-ALL: Lock down everything else to Admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
